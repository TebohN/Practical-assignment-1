public class RentalManager {
    // Learning Unit 1: Advanced Arrays (2D Array to store report summary data)
    private CarRental[] rentals;
    private int count;

    public RentalManager(int maxCapacity) {
        rentals = new CarRental[maxCapacity];
        count = 0;
    }

    public boolean addRental(CarRental rental) {
        if (count < rentals.length) {
            rentals[count] = rental;
            count++;
            return true;
        }
        return false;
    }

    // Advanced 2D Array generation for console report display
    public String[][] generateReportData() {
        String[][] reportData = new String[count][5];

        for (int i = 0; i < count; i++) {
            reportData[i][0] = rentals[i].getVehicleId();
            reportData[i][1] = rentals[i].getMakeModel();
            reportData[i][2] = String.valueOf(rentals[i].getRentalDays());
            reportData[i][3] = rentals[i].isIncludesInsurance() ? "Yes" : "No";
            reportData[i][4] = String.format("R%.2f", rentals[i].calculateTotalCost());
        }
        return reportData;
    }

    // Displays structured console report
    public void printConsoleReport() {
        System.out.println("\n=============================================================");
        System.out.println("                 CAR RENTAL SUMMARY REPORT                   ");
        System.out.println("=============================================================");
        System.out.printf("%-10s %-20s %-8s %-12s %-10s\n", "ID", "MAKE/MODEL", "DAYS", "INSURANCE", "TOTAL");
        System.out.println("-------------------------------------------------------------");

        String[][] data = generateReportData();
        // Loop through 2D Array
        for (int i = 0; i < data.length; i++) {
            System.out.printf("%-10s %-20s %-8s %-12s %-10s\n", 
                data[i][0], data[i][1], data[i][2], data[i][3], data[i][4]);
        }
        System.out.println("=============================================================\n");
    }

    public int getCount() {
        return count;
    }
}
